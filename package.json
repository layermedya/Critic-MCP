{
  "name": "critic-mcp",
  "version": "1.0.0",
  "description": "A Model Context Protocol (MCP) server providing automated, read-only code review and vulnerability analysis using LLMs.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/layermedya/Critic-MCP.git"
  },
  "homepage": "https://github.com/layermedya/Critic-MCP#readme",
  "bugs": {
    "url": "https://github.com/layermedya/Critic-MCP/issues"
  },
  "bin": {
    "critic-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-review",
    "critic",
    "ai"
  ],
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "openai": "^7.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  }
}
