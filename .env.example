# Completely OPTIONAL.
# The normal way to set your API key: run `npx critic-mcp auth` in your terminal.
# Environment variables always take precedence over ~/.critic-mcp.json (for CI/servers).

# LLM provider selection: "gemini" | "openai" | "deepseek"
# If empty, the choice in ~/.critic-mcp.json is used; if that is also absent, "gemini".
CRITIC_PROVIDER=

# --- API keys (optional; the auth flow is sufficient) ---
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Model selection ---
GEMINI_MODEL=gemini-3.6-flash
OPENAI_MODEL=gpt-4o-mini
# Base URL for DeepSeek etc. (deepseek defaults to https://api.deepseek.com).
OPENAI_BASE_URL=

# --- General ---
# LLM request timeout (ms). Default: 120000 (2 minutes)
CRITIC_TIMEOUT_MS=120000
# Chunking limit: code above this size triggers the map-reduce flow. Default: 30000
CHUNK_SIZE=30000
# Number of concurrent LLM requests during chunked review (rate-limit protection). Default: 3
CRITIC_CONCURRENCY=3
# Overrides the config file location. Default: ~/.critic-mcp.json
CRITIC_CONFIG_PATH=
